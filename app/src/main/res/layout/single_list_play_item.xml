        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:fontFamily="monospace"
        android:text="PlayerOne wins THREE of HEART > TWO of DIAMONDS "
        android:textColor="@color/black"
        android:textSize="16sp" />

</LinearLayout>